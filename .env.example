# Neon PostgreSQL: use uma URL pooled para a aplicação em produção.
# Copie a connection string no painel do Neon; mantenha-a apenas no servidor.
DATABASE_URL=

# Opcional: URL direta (sem pooler), útil para ferramentas de migração.
DATABASE_URL_UNPOOLED=

# Neon Auth — endpoints públicos informados para este projeto.
NEON_AUTH_BASE_URL=https://ep-flat-morning-b6tbuay1.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-flat-morning-b6tbuay1.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Gere um segredo aleatório forte com pelo menos 32 caracteres.
NEON_AUTH_COOKIE_SECRET=

# E-mail já cadastrado no Neon Auth; único endereço autorizado ao /admin.
ADMIN_EMAIL=

# Segredo aleatório usado para autorizar o job de importação agendado.
CRON_SECRET=

# Opcional: segredo independente para o limite do formulário da newsletter.
# Se vazio, o servidor usa CRON_SECRET, NEON_AUTH_COOKIE_SECRET ou, por último, DATABASE_URL.
NEWSLETTER_RATE_LIMIT_SECRET=

# Domínio usado em metadados e links do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Necessária para enviar o e-mail de confirmação da newsletter via Resend.
# Mantenha a chave real apenas no ambiente de servidor.
RESEND_API_KEY=

# Remetente do Resend, em um domínio já verificado. Exemplo: Anselmo Tech Notícias <noticias@seudominio.com.br>
NEWSLETTER_FROM_EMAIL=
