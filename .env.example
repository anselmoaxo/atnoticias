# Neon PostgreSQL: use uma URL pooled para a aplicação em produção.
# Copie a connection string no painel do Neon; mantenha-a apenas no servidor.
DATABASE_URL=

# Opcional: URL direta (sem pooler), útil para ferramentas de migração.
DATABASE_URL_UNPOOLED=

# Opcional: URL do papel dono do banco, usada só por npm run db:migrate. Veja db/roles.sql.
DATABASE_MIGRATION_URL=

# Neon Auth: copie as URLs do painel do Neon (Auth > Configuration).
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<regiao>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<regiao>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Gere um segredo aleatório forte com pelo menos 32 caracteres.
NEON_AUTH_COOKIE_SECRET=

# E-mail já cadastrado no Neon Auth; único endereço autorizado ao /admin.
ADMIN_EMAIL=

# ID do usuário admin, visível no painel do Neon (Auth > Users). Recomendado: com ele, só essa conta entra
# no painel. Sem ele, a conta de ADMIN_EMAIL precisa ter o e-mail verificado.
ADMIN_USER_ID=

# Segredo aleatório (mínimo 32 caracteres, ex.: openssl rand -hex 32) da rota /api/cron/import-news.
# Valores mais curtos são ignorados e a rota fica fechada.
CRON_SECRET=

# Obrigatório: segredo exclusivo (mínimo 32 caracteres) dos limites de tentativas da newsletter e do login.
# Sem ele, a inscrição na newsletter falha fechada e o login fica sem limite. NEWSLETTER_RATE_LIMIT_SECRET ainda é aceito como nome antigo.
RATE_LIMIT_SECRET=

# Domínio usado em metadados e links do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Necessária para enviar o e-mail de confirmação da newsletter via Resend.
# Mantenha a chave real apenas no ambiente de servidor.
RESEND_API_KEY=

# Remetente do Resend, em um domínio já verificado.
NEWSLETTER_FROM_EMAIL=Anselmo Tech Notícias <noreply@noticias.anselmotech.com.br>
